<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AFFE & Multi Arena - Inscrição Individual de Airsoft</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Teko:wght@600;700&family=Montserrat:wght@400;600;700;800&display=swap');
    .font-tactical { font-family: 'Teko', sans-serif; }
    .font-sans { font-family: 'Montserrat', sans-serif; }
    .tactical-bg {
      background: linear-gradient(135deg, #121619 0%, #1a232a 100%);
    }
  </style>
</head>
<body class="tactical-bg text-gray-100 min-h-screen font-sans antialiased">

  <!-- Header / Logos -->
  <header class="border-b border-yellow-500/30 bg-black/50 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <span class="text-2xl font-bold tracking-wider text-yellow-500 font-tactical">AFFE</span>
        <span class="text-gray-500">|</span>
        <span class="text-lg font-semibold tracking-widest text-white font-tactical">MULTI ARENA</span>
      </div>
      <div class="text-xs bg-yellow-500/10 text-yellow-400 border border-yellow-500/30 px-3 py-1 rounded-full font-semibold">
        Anápolis - GO
      </div>
    </div>
  </header>

  <!-- Main Hero & Form -->
  <main class="max-w-4xl mx-auto px-4 py-8">
    <div class="text-center mb-8">
      <span class="bg-yellow-500 text-black text-xs font-extrabold uppercase px-3 py-1 rounded-sm tracking-widest">
        Inscrição Individual para Funcionários
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold uppercase tracking-tight text-white mt-3 font-tactical">
        Treinamento de Airsoft Corporativo
      </h1>
      <p class="text-gray-300 max-w-2xl mx-auto text-sm md:text-base mt-2">
        Garanta sua vaga para a aula experimental do dia <strong class="text-yellow-400">20 de Novembro de 2026</strong> na Multi Arena e prepare-se para representar sua empresa na Batalha de Airsoft em 2027 (com participação da Polícia Civil).
      </p>
    </div>

    <!-- Cadastro Pessoa Física -->
    <div class="bg-gray-900/80 border border-gray-800 rounded-xl p-6 md:p-8 shadow-2xl backdrop-blur-sm">
      <form id="registrationForm" onsubmit="handleSubmit(event)" class="space-y-6">
        
        <!-- Bloco 1: Dados do Participante -->
        <div>
          <h2 class="text-lg font-bold text-yellow-400 uppercase tracking-wider mb-4 border-b border-gray-800 pb-2 flex items-center">
            <i class="fa-solid fa-user mr-2"></i> 1. Seus Dados Pessoais
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Nome Completo *</label>
              <input type="text" required placeholder="Digite seu nome completo" class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">CPF *</label>
              <input type="text" id="cpf" required placeholder="000.000.000-00" maxlength="14" oninput="formatCPF(this)" class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">WhatsApp / Telefone *</label>
              <input type="tel" required placeholder="(62) 90000-0000" class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">E-mail *</label>
              <input type="email" required placeholder="seuemail@exemplo.com" class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
            </div>
          </div>
        </div>

        <!-- Bloco 2: Empresa onde trabalha -->
        <div>
          <h2 class="text-lg font-bold text-yellow-400 uppercase tracking-wider mb-4 border-b border-gray-800 pb-2 flex items-center">
            <i class="fa-solid fa-building mr-2"></i> 2. Empresa onde Trabalha
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Nome da Empresa *</label>
              <input type="text" required placeholder="Ex: CAOA, Comércio Local, etc." class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Seu Cargo / Setor *</label>
              <input type="text" required placeholder="Ex: Montagem, Vendas, TI" class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
            </div>
          </div>
        </div>

        <!-- Bloco 3: Contato de Emergência -->
        <div>
          <h2 class="text-lg font-bold text-yellow-400 uppercase tracking-wider mb-4 border-b border-gray-800 pb-2 flex items-center">
            <i class="fa-solid fa-phone-safety mr-2"></i> 3. Contato de Emergência
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Nome do Contato *</label>
              <input type="text" required placeholder="Familiar ou Responsável" class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase text-gray-400 mb-1">Telefone de Emergência *</label>
              <input type="tel" required placeholder="(62) 90000-0000" class="w-full bg-gray-800 border border-gray-700 rounded px-3 py-2 text-white focus:outline-none focus:border-yellow-500">
            </div>
          </div>
        </div>

        <!-- LGPD & Aceite -->
        <div class="pt-2">
          <label class="flex items-start space-x-3 text-xs text-gray-400 cursor-pointer">
            <input type="checkbox" required class="mt-0.5 rounded bg-gray-800 border-gray-700 text-yellow-500 focus:ring-0">
            <span>
              Concordo com a utilização dos meus dados para o cadastro do evento de Airsoft da AFFE / Multi Arena, em conformidade com a LGPD.
            </span>
          </label>
        </div>

        <!-- Botão de Envio -->
        <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-400 text-black font-extrabold py-3 rounded text-lg uppercase tracking-wider transition-colors shadow-lg">
          Garantir Minha Vaga na Aula Experimental
        </button>
      </form>
    </div>
  </main>

  <script>
    function formatCPF(input) {
      let v = input.value.replace(/\D/g, '');
      if (v.length > 11) v = v.substring(0, 11);
      v = v.replace(/(\d{3})(\d)/, '$1.$2');
      v = v.replace(/(\d{3})(\d)/, '$1.$2');
      v = v.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
      input.value = v;
    }

    function handleSubmit(e) {
      e.preventDefault();
      alert('Cadastro de Participante realizado com sucesso! Aguarde nosso contato via WhatsApp.');
      document.getElementById('registrationForm').reset();
    }
  </script>
</body>
</html>
